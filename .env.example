# Copy to .env (gitignored) for docker compose. Never commit real secrets.
# Compose interpolates these and passes .env into the container; unset values fall back
# to the defaults in docker-compose.yml or the application.

# --- Access control (EVAL_API_*) ---------------------------------------------
# Required by POST /v1/eval/run and GET /v1/eval/report/* when set. >= 32 characters,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# EVAL_API_API_KEY=
# Extra hosts a run request may point rag_url at (JSON list), besides EVAL_RAG_URL's host.
# EVAL_API_ALLOWED_RAG_HOSTS=["rag.internal"]
# EVAL_API_MAX_CONCURRENT_RUNS=1
# EVAL_API_MAX_REQUEST_BYTES=16777216

# --- RAG system under test (EVAL_RAG_*) --------------------------------------
# Defaults match the rag_documents service (POST /rag/answer, {"query": ...}).
# EVAL_RAG_URL=http://host.docker.internal:8000/rag/answer
# EVAL_RAG_API_KEY=
# EVAL_RAG_QUERY_FIELD=query
# EVAL_RAG_ANSWER_PATH=answer
# EVAL_RAG_CONTEXTS_PATH=sources
# EVAL_RAG_CONTEXT_TEXT_FIELD=preview
# EVAL_RAG_EXTRA_PAYLOAD={"k": 5}

# --- Benchmark run (EVAL_*) ---------------------------------------------------
# heuristic | mock (offline, deterministic) | ragas | trulens (need EVAL_PROVIDER_*)
# EVAL_JUDGE_MODEL=heuristic
# EVAL_CONCURRENCY_LIMIT=5
# EVAL_TIMEOUT_SECONDS=30
# EVAL_RETRY_ATTEMPTS=3
# Inside the image this is a tmpfs; mount a volume there to keep run history.
# EVAL_OUTPUT_DIR=/app/.cache/eval_runs

# --- Judge provider for ragas / trulens (EVAL_PROVIDER_*) ---------------------
# openai covers every OpenAI-compatible endpoint via EVAL_PROVIDER_BASE_URL.
# EVAL_PROVIDER_PROVIDER=openai
# EVAL_PROVIDER_LLM_MODEL=
# EVAL_PROVIDER_EMBEDDING_MODEL=
# provider | hashing (offline embeddings; required with anthropic)
# EVAL_PROVIDER_EMBEDDINGS=provider
# EVAL_PROVIDER_BASE_URL=
# EVAL_PROVIDER_API_KEY=
# EVAL_PROVIDER_FALLBACK_TO_HEURISTIC=true

# --- Compose only -------------------------------------------------------------
# EVAL_BIND=127.0.0.1

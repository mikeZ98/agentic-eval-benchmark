# shellcheck shell=bash
# agentic-eval-benchmark — direnv environment.
#
# Pins every cache, virtualenv, temp dir, eval artifact store and container config
# under ./.cache/ so nothing spills onto the internal macOS disk. Run `direnv allow` once.

# ---------------------------------------------------------------------------
# Project root & optional storage-volume guard (fails closed once configured)
# ---------------------------------------------------------------------------
PROJECT_ROOT="$(cd "$(expand_path .)" && pwd -P)"
# Machine-specific overrides live in the git-ignored .envrc.local. Setting
# STORAGE_VOLUME there makes direnv refuse to load unless the project sits on
# that mounted volume, e.g.
#   export STORAGE_VOLUME="/Volumes/<external-drive>"
source_env_if_exists .envrc.local
STORAGE_VOLUME="${STORAGE_VOLUME:-}"

if [[ -n "$STORAGE_VOLUME" && "$(uname -s)" == "Darwin" ]]; then
  if ! mount | grep -qF " on $STORAGE_VOLUME ("; then
    log_error "$STORAGE_VOLUME is not mounted — refusing to load (caches would land elsewhere)."
    exit 1
  fi
  if [[ "$PROJECT_ROOT" != "$STORAGE_VOLUME"/* ]]; then
    log_error "PROJECT_ROOT ($PROJECT_ROOT) resolves outside $STORAGE_VOLUME — refusing to load."
    exit 1
  fi
fi
if [[ ! -w "$PROJECT_ROOT" ]]; then
  log_error "$PROJECT_ROOT is not writable (read-only mount?) — refusing to load."
  exit 1
fi

export PROJECT_ROOT STORAGE_VOLUME
export CACHE_ROOT="$PROJECT_ROOT/.cache"

# ---------------------------------------------------------------------------
# XDG + temp
# ---------------------------------------------------------------------------
export XDG_CACHE_HOME="$CACHE_ROOT/xdg"
export XDG_DATA_HOME="$CACHE_ROOT/xdg-data"
export XDG_STATE_HOME="$CACHE_ROOT/xdg-state"
export TMPDIR="$CACHE_ROOT/tmp"
export TMP="$TMPDIR" TEMP="$TMPDIR"

# ---------------------------------------------------------------------------
# Python toolchain (uv-managed CPython 3.13, venv outside the source tree)
# ---------------------------------------------------------------------------
export UV_CACHE_DIR="$CACHE_ROOT/uv"
export UV_PYTHON_INSTALL_DIR="$CACHE_ROOT/uv-python"
export UV_TOOL_DIR="$CACHE_ROOT/uv-tools"
export UV_TOOL_BIN_DIR="$CACHE_ROOT/uv-tools/bin"
export UV_PROJECT_ENVIRONMENT="$CACHE_ROOT/venv"
export UV_PYTHON="3.13"
export UV_PYTHON_PREFERENCE="only-managed"
export UV_LINK_MODE="copy"
export PIP_CACHE_DIR="$CACHE_ROOT/pip"
export PYTHONPYCACHEPREFIX="$CACHE_ROOT/pycache"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"

# Linters / type checker / test runner / scanners
export RUFF_CACHE_DIR="$CACHE_ROOT/ruff"
export MYPY_CACHE_DIR="$CACHE_ROOT/mypy"
export COVERAGE_FILE="$CACHE_ROOT/coverage/.coverage"
export TRIVY_CACHE_DIR="$CACHE_ROOT/trivy"

# ---------------------------------------------------------------------------
# Evaluation stack (Ragas / TruLens / HF / tokenizers): local, offline-friendly
# ---------------------------------------------------------------------------
export HF_HOME="$CACHE_ROOT/huggingface"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export TIKTOKEN_CACHE_DIR="$CACHE_ROOT/tiktoken"
export NLTK_DATA="$CACHE_ROOT/nltk"
export MPLCONFIGDIR="$CACHE_ROOT/matplotlib"
# BenchmarkSettings (EVAL_* prefix) persists run reports here.
export EVAL_OUTPUT_DIR="$CACHE_ROOT/eval_runs"
export TRULENS_HOME="$CACHE_ROOT/trulens"
export TRULENS_DATABASE_URL="sqlite:///$TRULENS_HOME/trulens.sqlite"
# No usage telemetry leaves the machine.
export RAGAS_DO_NOT_TRACK="true"
export TRULENS_OTEL_TRACING="0"
export HF_HUB_DISABLE_TELEMETRY="1"
export DO_NOT_TRACK="1"

# ---------------------------------------------------------------------------
# Containers (Colima + Docker CLI)
# ---------------------------------------------------------------------------
export COLIMA_HOME="$CACHE_ROOT/colima"
# Not $COLIMA_HOME/_lima: Lima socket paths (…/<instance>/ssh.sock.<16 chars>) must stay
# under the 104-byte UNIX_PATH_MAX, and this project path is long.
export LIMA_HOME="$CACHE_ROOT/lima"
export DOCKER_HOST="unix://$COLIMA_HOME/default/docker.sock"
export DOCKER_CONFIG="$CACHE_ROOT/docker"
export BUILDX_CONFIG="$DOCKER_CONFIG/buildx"

mkdir -p \
  "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$TMPDIR" \
  "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$UV_TOOL_BIN_DIR" "$PIP_CACHE_DIR" "$PYTHONPYCACHEPREFIX" \
  "$RUFF_CACHE_DIR" "$MYPY_CACHE_DIR" "$CACHE_ROOT/pytest" "$CACHE_ROOT/coverage" "$TRIVY_CACHE_DIR" \
  "$HF_DATASETS_CACHE" "$TIKTOKEN_CACHE_DIR" "$NLTK_DATA" "$MPLCONFIGDIR" "$EVAL_OUTPUT_DIR" "$TRULENS_HOME" \
  "$LIMA_HOME" "$BUILDX_CONFIG"

# ---------------------------------------------------------------------------
# Git: hooks + sole-contributor identity (see CONTRIBUTING.md)
# ---------------------------------------------------------------------------
# Identity values mirror .githooks/_policy.sh (the enforcement source of truth).
if git -C "$PROJECT_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$PROJECT_ROOT" config core.hooksPath .githooks
  git -C "$PROJECT_ROOT" config user.name "mikeZ98"
  git -C "$PROJECT_ROOT" config user.email "145975972+mikeZ98@users.noreply.github.com"
  git -C "$PROJECT_ROOT" config user.useConfigOnly true
fi

